---
import BaseLayout from '../layouts/BaseLayout.astro'
import JourneySection from '../components/JourneySection.astro'
import NewsSection from '../components/NewsSection.astro'
import ActivitiesSection from '../components/ActivitiesSection.astro'
import WorksSection from '../components/WorksSection.astro'
import SkillsSection from '../components/SkillsSection.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import TurtleFlip from '../components/TurtleFlip.astro'

const navItems = [
  { href: '#timeline', label: 'Journey' },
  { href: '#activities', label: 'Activities' },
  { href: '#works', label: 'Works' },
  { href: '#skills', label: 'Skills' },
  { href: '#news', label: 'News' },
  { href: '#contact', label: 'Contact' },
]
---

<BaseLayout
  title="どうも、たーとるです。"
  description="テクノロジーで、社会の課題解決に挑戦しています。"
>
  <header class="bg-white dark:bg-gray-800 shadow-md sticky top-0 z-50">
    <nav class="container mx-auto px-6 py-3 sm:py-4 flex flex-wrap items-center justify-between gap-y-2">
      <div class="flex items-center gap-2">
        <a href="#hero" class="text-xl sm:text-2xl font-bold text-blue-600 dark:text-blue-400">
          lazyta-toru.net
        </a>
      </div>
      <div class="flex items-center gap-4 sm:gap-6 order-last sm:order-none w-full sm:w-auto overflow-x-auto text-sm sm:text-base">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class="shrink-0 text-gray-600 dark:text-gray-300 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              {item.label}
            </a>
          ))
        }
      </div>
      <ThemeToggle />
    </nav>
  </header>

  <main class="container mx-auto px-6 py-12">
    <section id="hero" class="text-center py-16">
      <TurtleFlip />

      <h1 class="text-4xl md:text-5xl font-bold mt-6">
        どうも、<span class="flip-name" aria-live="polite"
          ><span data-flip-front>たーとる</span><span data-flip-back hidden>亀井亮磨</span></span
        >です。
      </h1>
      <p class="text-xl md:text-2xl text-gray-700 dark:text-gray-300 mt-4">
        テクノロジーで、社会の課題解決に挑戦しています。
      </p>
      <p class="mt-2 text-gray-600 dark:text-gray-400">大学2年生 / SFC / 交通 × IT（ITS 高度道路交通システム） / 技術と組織</p>
    </section>

    <JourneySection />
    <ActivitiesSection />
    <WorksSection />
    <SkillsSection />
    <NewsSection />

    <section id="contact" class="py-16 text-center">
      <h2 class="text-3xl font-bold mb-8">Contact</h2>
      <div class="flex justify-center space-x-6">
        <a
          href="https://github.com/Lazyturtle0852"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub"
          class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.477 2 12c0 4.418 2.865 8.165 6.839 9.489.5.092.682-.217.682-.483 0-.237-.009-.868-.013-1.703-2.782.604-3.369-1.342-3.369-1.342-.455-1.158-1.11-1.465-1.11-1.465-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.685-.103-.253-.446-1.27.098-2.647 0 0 .84-.27 2.75 1.025.797-.222 1.643-.332 2.484-.336.841.004 1.687.114 2.484.336 1.91-1.294 2.747-1.025 2.747-1.025.546 1.377.201 2.394.1 2.647.64.701 1.028 1.594 1.028 2.685 0 3.843-2.339 4.686-4.566 4.935.359.309.678.92.678 1.856 0 1.34-.012 2.42-.012 2.747 0 .268.18.578.688.482A10.001 10.001 0 0022 12c0-5.523-4.477-10-10-10z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
        <a
          href="https://x.com/namakekame"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="X (Twitter)"
          class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <svg class="w-10 h-10" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            ></path>
          </svg>
        </a>
        <a
          href="mailto:kamenogakkou@gmail.com"
          aria-label="メール"
          class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
        >
          <svg class="w-10 h-10" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
            ></path>
          </svg>
        </a>
      </div>
    </section>
  </main>

  <footer class="bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 mt-16">
    <div class="container mx-auto px-6 py-8 text-center text-gray-600 dark:text-gray-400">
      このサイトはCI/CDで自動デプロイされています。
      <br />
      &copy; {new Date().getFullYear()} たーとる. All rights reserved.
    </div>
  </footer>
</BaseLayout>
