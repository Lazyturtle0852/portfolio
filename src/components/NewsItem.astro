---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'
import { render } from 'astro:content'

interface Props {
  item: CollectionEntry<'news'>
}

const { item } = Astro.props
const { Content } = await render(item)

const categories = {
  release: { label: 'リリース', class: 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200' },
  join: { label: '所属', class: 'bg-emerald-100 text-emerald-800 dark:bg-emerald-900 dark:text-emerald-200' },
  event: { label: 'イベント', class: 'bg-purple-100 text-purple-800 dark:bg-purple-900 dark:text-purple-200' },
  press: { label: '掲載', class: 'bg-amber-400 text-amber-950' },
  award: { label: '選出', class: 'bg-amber-400 text-amber-950' },
  update: { label: 'お知らせ', class: 'bg-gray-200 text-gray-700 dark:bg-gray-700 dark:text-gray-200' },
}

const category = categories[item.data.category]
// 掲載・選出は外からの評価なので、行ごと目立たせる
const highlight = item.data.category === 'press' || item.data.category === 'award'
const date = item.data.date.toISOString().slice(0, 10)
---

<li class="relative grid grid-cols-1 sm:grid-cols-[6.5rem_1fr] sm:gap-x-4">
  <time datetime={date} class="hidden sm:block pt-3 text-sm font-semibold tabular-nums text-gray-500 dark:text-gray-400 text-right">
    {date.replaceAll('-', '.')}
  </time>
  <div
    class:list={[
      'relative border-l-2 border-gray-300 dark:border-gray-700 pl-4 sm:pl-5 pb-5',
      'before:absolute before:-left-[7px] before:top-4 before:w-3 before:h-3 before:rounded-full',
      highlight ? 'before:bg-amber-400' : 'before:bg-blue-600 dark:before:bg-blue-400',
    ]}
  >
    <div
      class:list={[
        'flex gap-4 rounded-lg p-3',
        highlight && 'bg-amber-50 dark:bg-amber-950/40 ring-1 ring-amber-300/70 dark:ring-amber-700/60',
      ]}
    >
      <div class="flex-1 min-w-0">
        <time datetime={date} class="sm:hidden block text-xs font-semibold tabular-nums text-gray-500 dark:text-gray-400 mb-1">
          {date.replaceAll('-', '.')}
        </time>
        <p class="flex flex-wrap items-center gap-2 mb-1">
          <span class={`rounded-full px-2 py-0.5 text-xs font-bold ${category.class}`}>{category.label}</span>
          {
            item.data.link ? (
              <a
                href={item.data.link}
                target="_blank"
                rel="noopener noreferrer"
                class="font-bold hover:text-blue-600 dark:hover:text-blue-400 hover:underline"
              >
                {item.data.title}
              </a>
            ) : (
              <span class="font-bold">{item.data.title}</span>
            )
          }
        </p>
        <div class="text-sm text-gray-600 dark:text-gray-400 line-clamp-2">
          <Content />
        </div>
      </div>
      {
        item.data.image ? (
          <Image
            src={item.data.image}
            alt=""
            width={128}
            height={128}
            class="hidden sm:block w-14 h-14 shrink-0 rounded-md object-cover"
          />
        ) : null
      }
    </div>
  </div>
</li>
