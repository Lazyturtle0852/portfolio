---
import { getCollection } from 'astro:content'
import NewsItem from './NewsItem.astro'

// 新しい順。同じ日付はファイル名の降順で並べる
const newsItems = (await getCollection('news')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime() || b.id.localeCompare(a.id),
)
---

<section id="news" class="py-16">
  <h2 class="text-3xl font-bold text-center mb-10">News</h2>
  <ol class="max-w-2xl mx-auto border-t border-gray-200 dark:border-gray-800">
    {newsItems.map((item) => <NewsItem item={item} />)}
  </ol>
</section>
