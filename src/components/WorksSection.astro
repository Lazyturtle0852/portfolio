---
import WorkCard from './WorkCard.astro'
import { works } from '../data/projects'

const recent = works.filter((work) => work.era === 'university')
const earlier = works.filter((work) => work.era !== 'university')
---

<section id="works" class="py-16">
  <h2 class="text-3xl font-bold text-center mb-3">Works</h2>
  <p class="text-center text-gray-600 dark:text-gray-400 mb-12">作ったもの・挑戦したこと</p>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {recent.map((work) => <WorkCard work={work} />)}
  </div>
  <h3 class="text-xl font-bold text-gray-600 dark:text-gray-400 mt-16 mb-6">高校まで</h3>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {earlier.map((work) => <WorkCard work={work} />)}
  </div>
</section>
