---
import { Image } from 'astro:assets'
import { activities, works } from '../data/projects'
import { timelineItems } from '../data/timeline'

// 各時代の写真。押すと Works / Activities の該当カードへ飛ぶ
const thumbsByEra = timelineItems.map((item) => [
  ...works
    .filter((work) => work.era === item.era && work.journey !== false)
    .map((work) => ({ href: `#work-${work.id}`, title: work.title, image: work.image })),
  ...activities
    .filter((activity) => activity.era === item.era && activity.image && activity.journey !== false)
    .map((activity) => ({
      href: `#activity-${activity.id}`,
      title: activity.title,
      image: activity.image!,
    })),
])

// PC では写真を右・左・右…と交互に、カード列の外側の余白へ置く。
// 縦位置は下のスクリプトで、各時代の行の高さに合わせて重ならないよう決める
const gutterThumbs = thumbsByEra.flatMap((thumbs, row) => thumbs.map((thumb) => ({ ...thumb, row })))
// x は列の端からの距離、size は一辺（px）。1280px 幅でも収まるよう x + size は 220 以下
const gutterLooks = [
  { x: 40, size: 128 },
  { x: 84, size: 112 },
  { x: 28, size: 120 },
  { x: 96, size: 108 },
]

// PC 以外では最大3枚を、スマホは時代ラベルの行の右に横一列、タブレットはカードの右に2列で置く。
// どちらも行の高さを増やさないよう、空いている場所に置く
---

<section id="timeline" class="py-16">
  <h2 class="text-3xl font-bold text-center mb-16">My Journey</h2>
  <div class="relative max-w-3xl lg:max-w-2xl xl:max-w-3xl mx-auto px-4" data-journey>
    {
      timelineItems.map((item, i) => (
        <div class="relative pl-8 sm:pl-32 py-6 group" data-journey-row={i}>
          <div class="absolute inset-y-0 left-0 w-1 bg-gray-300 dark:bg-gray-700 rounded-full ml-4 -translate-x-1/2" />
          <div class="absolute w-5 h-5 bg-blue-600 dark:bg-blue-400 rounded-full left-4 -translate-x-1/2 top-1/2 -translate-y-1/2 shadow-lg" />
          <div class="flex flex-col sm:flex-row items-start">
            <time class="sm:absolute left-0 translate-y-0.5 inline-block w-auto sm:w-28 text-sm font-semibold uppercase text-gray-600 dark:text-gray-400 mb-2 sm:mb-0 sm:text-right pr-4">
              {item.period}
            </time>
            <div
              class:list={[
                'bg-white dark:bg-gray-800 rounded-lg shadow-xl p-6 ml-4 sm:ml-0 flex-1 relative',
                thumbsByEra[i].length > 0 && 'sm:mr-36 lg:mr-0',
              ]}
            >
              <div class="absolute top-1/2 -left-4 w-4 h-4 bg-white dark:bg-gray-800 transform -translate-y-1/2 rotate-45 hidden sm:block" />
              <h3 class="text-xl font-bold mb-1">{item.title}</h3>
              <p class="text-gray-700 dark:text-gray-300">{item.body}</p>
            </div>
            {thumbsByEra[i].length > 0 ? (
              <ul class="lg:hidden absolute right-0 top-3 sm:top-1/2 sm:-translate-y-1/2 flex gap-2 sm:grid sm:grid-cols-2 sm:gap-2.5">
                {thumbsByEra[i].slice(0, 3).map((thumb, j) => (
                  <li
                    class="float-thumb"
                    style={`--delay: ${-j * 1.3}s`}
                  >
                    <a href={thumb.href} title={thumb.title} class="float-thumb__card">
                      <Image
                        src={thumb.image}
                        alt={thumb.title}
                        width={160}
                        height={160}
                        class="w-10 h-10 sm:w-14 sm:h-14 object-cover"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </div>


        </div>
      ))
    }

    <ul class="journey-gutter hidden lg:block absolute inset-0 pointer-events-none" aria-label="各時代の写真">
      {
        gutterThumbs.map((thumb, j) => {
          const look = gutterLooks[Math.floor(j / 2) % gutterLooks.length]
          const prop = j % 2 === 0 ? 'left' : 'right'
          return (
            <li
              class="float-thumb absolute pointer-events-auto"
              data-row={thumb.row}
              data-side={prop}
              style={`${prop}: calc(100% + ${look.x}px * var(--gap-scale)); width: calc(${look.size}px * var(--size-scale)); --size: calc(${look.size}px * var(--size-scale)); --delay: ${-j * 1.3}s`}
            >
              <a href={thumb.href} title={thumb.title} class="float-thumb__card">
                <Image
                  src={thumb.image}
                  alt={thumb.title}
                  width={320}
                  height={320}
                  class="float-thumb__img object-cover"
                />
              </a>
            </li>
          )
        })
      }
    </ul>
  </div>
</section>

<script>
  // 写真を各時代の行の横に置き、同じ側で重ならないよう上下にずらす。
  // 行の高さは写真に左右されないので、カード同士の間隔は等しいまま
  const GAP = 24

  function layout(wrapper: HTMLElement) {
    const gutter = wrapper.querySelector<HTMLElement>('.journey-gutter')
    if (!gutter || getComputedStyle(gutter).display === 'none') return
    const rows = [...wrapper.querySelectorAll<HTMLElement>('[data-journey-row]')]
    const lastRow = rows[rows.length - 1]
    const end = lastRow.offsetTop + lastRow.offsetHeight
    let lowest = 0

    for (const side of ['left', 'right']) {
      const items = [...gutter.querySelectorAll<HTMLElement>(`li[data-side="${side}"]`)].map((li) => {
        const row = rows[Number(li.dataset.row)]
        // まずは自分の時代の行の中央に置きたい
        const want = row.offsetTop + row.offsetHeight / 2 - li.offsetHeight / 2
        return { li, h: li.offsetHeight, top: want }
      })
      // 上から順に、前の写真と重ならない位置まで下げる
      let bottom = -Infinity
      for (const item of items) {
        item.top = Math.max(item.top, bottom + GAP, 0)
        bottom = item.top + item.h
      }
      // 下にはみ出すぶんは、上の空いている余白へ詰め直す
      let limit = end
      for (const item of items.toReversed()) {
        item.top = Math.max(0, Math.min(item.top, limit - item.h))
        limit = item.top - GAP
      }
      bottom = -Infinity
      for (const item of items) {
        item.top = Math.max(item.top, bottom + GAP)
        bottom = item.top + item.h
        item.li.style.top = `${item.top}px`
      }
      lowest = Math.max(lowest, bottom)
    }
    // それでも最後のカードより下まで続くぶん、次のセクションとの間をあける
    wrapper.style.paddingBottom = `${Math.max(0, lowest - wrapper.offsetHeight + 16)}px`
    gutter.classList.add('is-ready')
  }

  for (const wrapper of document.querySelectorAll<HTMLElement>('[data-journey]')) {
    const run = () => {
      wrapper.style.paddingBottom = ''
      layout(wrapper)
    }
    run()
    new ResizeObserver(run).observe(wrapper.querySelector('[data-journey-row]')!.parentElement!)
    window.addEventListener('resize', run)
  }
</script>
