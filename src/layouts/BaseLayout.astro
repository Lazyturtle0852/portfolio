---
import '../styles/global.css'
import turtleIcon from '../assets/images/turtle-icon.jpeg'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const ogImage = new URL(turtleIcon.src, Astro.site)
// GitHub Pages のプレビューは検索に載せない
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true'
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content="たーとるのポートフォリオ" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="たーとるのポートフォリオ" />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href={turtleIcon.src} type="image/jpeg" />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}
    <!-- Google Fonts (Inter + Noto Sans JP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- 描画前にテーマを決めて、ライト→ダークのちらつきを防ぐ -->
    <script is:inline>
      try {
        const stored = localStorage.getItem('theme')
        const dark =
          stored === 'dark' ||
          (stored === null && window.matchMedia('(prefers-color-scheme: dark)').matches)
        document.documentElement.classList.toggle('dark', dark)
      } catch {
        // localStorage が使えない環境では OS 設定に従う
        if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.classList.add('dark')
        }
      }
    </script>
  </head>
  <body
    class="bg-gray-100 dark:bg-gray-900 text-gray-900 dark:text-gray-100 selection:bg-blue-200 dark:selection:bg-blue-800 transition-colors duration-300"
  >
    <slot />
  </body>
</html>
